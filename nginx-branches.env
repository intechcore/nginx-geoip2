# nginx branches this image is built for, read by the workflows and the Makefile.
# Mainline has an odd minor version, stable an even one. Each branch pins the
# nginx base image by the digest of its multi-arch index, and takes the GeoIP2
# module built for its nginx version by intechcore/ngx_http_geoip2_module. The
# nginx version comes from the image tag. It must equal the nginx version of
# the module tag: .github/scripts/branch-versions.sh fails otherwise.
# Renovate keeps both lines of a branch current in one PR, see renovate.json.

# renovate: branch=mainline nginx
MAINLINE_NGINX_IMAGE=nginx:1.31.8-trixie@sha256:6e67f8eaac94fc456588d4ff6c470d984841f5b5dc4279863d5cbe6ec5a60def
# renovate: branch=mainline module
MAINLINE_GEOIP2_MODULE=ghcr.io/intechcore/ngx_http_geoip2_module:1.31.8-1@sha256:4160ed206b292ef8f1ad8cac222079edb9af7890076a04bf623cf5218ee3f1a5

# renovate: branch=stable nginx
STABLE_NGINX_IMAGE=nginx:1.30.6-trixie@sha256:a7675fcee220f59b4a99f7098c06a0d5d999c2c0ee37c0211efb780536e5cb20
# renovate: branch=stable module
STABLE_GEOIP2_MODULE=ghcr.io/intechcore/ngx_http_geoip2_module:1.30.6-1@sha256:40311d04f0e587d3bbfe0d0b00d61149856f851634ef18de80b0d88ce5efeb17
