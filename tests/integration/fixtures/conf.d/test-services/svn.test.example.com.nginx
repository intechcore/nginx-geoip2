server {
    listen                      8443 ssl;
    server_name                 svn.test.example.com;
    http2                       on;

    include /etc/nginx/conf.d/includes/ssl-test.nginx;
    include /etc/nginx/conf.d/includes/security-headers.nginx;

    client_max_body_size        0;
    chunked_transfer_encoding   on;

    set $is_allowed 0;
    if ($is_partner_alpha = 1) { set $is_allowed 1; }
    if ($is_partner_beta = 1) { set $is_allowed 1; }
    if ($is_monitoring = 1) { set $is_allowed 1; }
    if ($is_private_networks = 1) { set $is_allowed 1; }
    if ($is_geo_allowed = 1) { set $is_allowed 1; }

    location / {
        if ($is_allowed = 0) { return 403; }

        include /etc/nginx/conf.d/includes/proxy-defaults.nginx;

        proxy_pass              http://backend:8000;
    }

    include /etc/nginx/conf.d/includes/debug-location.nginx;
}
