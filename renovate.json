{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update nginx version in Dockerfile ARG and workflow defaults",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.github/workflows/.*\\.yml$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ARG NGINX_VERSION=(?<currentValue>\\S+)",
        "# renovate: nginx\\n\\s*NGINX_VERSION:\\s*'(?<currentValue>[\\d.]+)'",
        "# renovate: nginx\\n\\s*echo \"version=(?<currentValue>[\\d.]+)\"",
        "# renovate: nginx\\nNGINX_VERSION \\?= (?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "nginx",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all nginx version updates into a single PR",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "nginx"
      ],
      "groupName": "nginx version"
    },
    {
      "description": "Disable updates for debian:stable (floating tag, always current)",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "debian"
      ],
      "enabled": false
    }
  ]
}
