{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update nginx version in Dockerfile ARG and workflow defaults",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.github/workflows/.*\\.yml$/",
        "/^Makefile$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "ARG NGINX_VERSION=(?<currentValue>\\S+)",
        "# renovate: nginx\\n\\s*NGINX_VERSION:\\s*'(?<currentValue>[\\d.]+)'",
        "# renovate: nginx\\n\\s*echo \"version=(?<currentValue>[\\d.]+)\"",
        "# renovate: nginx\\nNGINX_VERSION \\?= (?<currentValue>[\\d.]+)",
        "# renovate: nginx\\nmake build\\s+# builds nginx-geoip2:(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "nginx",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[\\d.]+)-trixie$"
    },
    {
      "customType": "regex",
      "description": "Update nginx-geoip image tag in README",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: image=ghcr\\.io/intechcore/nginx-geoip\\n\\s*image: ghcr\\.io/intechcore/nginx-geoip:(?<currentValue>[\\d.]+-\\d+)"
      ],
      "depNameTemplate": "ghcr.io/intechcore/nginx-geoip",
      "datasourceTemplate": "docker"
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "itcsrvs",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Group all nginx version updates into a single PR",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "nginx"
      ],
      "groupName": "nginx version"
    },
    {
      "description": "Disable updates for debian:stable (floating tag, always current)",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "debian"
      ],
      "enabled": false
    }
  ]
}
