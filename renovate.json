{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "nginx version of each branch. It follows the tags of the GeoIP2 module image, so it moves only when a module for the new nginx version exists. depType is the branch.",
      "managerFilePatterns": [
        "/^nginx-branches\\.env$/",
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: branch=(?<depType>mainline|stable) nginx\\n(?:ARG )?[A-Z0-9_]+=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "nginx",
      "packageNameTemplate": "ghcr.io/intechcore/ngx_http_geoip2_module",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-\\d+$"
    },
    {
      "customType": "regex",
      "description": "GeoIP2 module image of each branch, with its digest. depType is the branch.",
      "managerFilePatterns": [
        "/^nginx-branches\\.env$/",
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: branch=(?<depType>mainline|stable) module\\n(?:ARG )?[A-Z0-9_]+=ghcr\\.io/intechcore/ngx_http_geoip2_module:(?<currentValue>\\d+\\.\\d+\\.\\d+-\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "ghcr.io/intechcore/ngx_http_geoip2_module",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update nginx-geoip image tag in README",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: image=ghcr\\.io/intechcore/nginx-geoip\\n\\s*image: ghcr\\.io/intechcore/nginx-geoip:(?<currentValue>[\\d.]+-\\d+)"
      ],
      "depNameTemplate": "ghcr.io/intechcore/nginx-geoip",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update supercronic release version in Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=aptible/supercronic\\nARG SUPERCRONIC_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "aptible/supercronic",
      "datasourceTemplate": "github-releases"
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "itcsrvs",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Mainline: nginx version and module in one PR, odd minor versions only.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "mainline"
      ],
      "groupName": "nginx mainline",
      "allowedVersions": "/^\\d+\\.\\d*[13579]\\./"
    },
    {
      "description": "Stable: nginx version and module in one PR, even minor versions only.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "stable"
      ],
      "groupName": "nginx stable",
      "allowedVersions": "/^\\d+\\.\\d*[02468]\\./"
    },
    {
      "description": "Own image, private on ghcr.io (see hostRules). Every release publishes the exact build tag (1.31.6-1) next to the moving tag (1.31.6) and latest. Regex versioning tracks only the exact one and orders by the build number. Docker versioning would read -N as a compatibility tag and hide rebuilds.",
      "matchPackageNames": [
        "ghcr.io/intechcore/nginx-geoip"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "description": "GeoIP2 module tags are <nginx>-<build>. Regex versioning orders them and ignores the moving <nginx> tag.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "ghcr.io/intechcore/ngx_http_geoip2_module"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "description": "The dockerfile manager reads FROM nginx:${NGINX_VERSION}-trixie and FROM ${GEOIP2_MODULE} through the ARG defaults. The regex managers own those ARGs.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "nginx",
        "ghcr.io/intechcore/ngx_http_geoip2_module"
      ],
      "enabled": false
    }
  ]
}
